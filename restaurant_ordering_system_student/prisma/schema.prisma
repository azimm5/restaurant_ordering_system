generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model feedback {
  feedbackId Int        @id @default(autoincrement()) @map("feedback_id")
  memberId   Int        @map("member_id")
  productId  Int        @map("product_id")
  orderId    Int        @map("order_id")
  rating     Int
  comment    String?
  createdAt  DateTime?  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt  DateTime?  @default(now()) @map("updated_at") @db.Timestamp(6)
  member     member     @relation(fields: [memberId], references: [memberId], onDelete: NoAction, onUpdate: NoAction, map: "fk_member")
  saleOrder  saleOrder  @relation(fields: [orderId], references: [orderId], onDelete: NoAction, onUpdate: NoAction, map: "fk_order")
  product    product    @relation(fields: [productId], references: [productId], onDelete: NoAction, onUpdate: NoAction, map: "fk_product")
  response   response[]

  @@unique([memberId, productId, orderId], map: "feedback_unique_member_product_order")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model member {
  memberId     Int         @id @default(autoincrement()) @map("member_id")
  username     String      @unique @db.VarChar(50)
  email        String      @unique @db.VarChar(100)
  passwordHash String      @map("password_hash") @db.VarChar(255)
  firstName    String      @map("first_name") @db.VarChar(50)
  lastName     String      @map("last_name") @db.VarChar(50)
  createdAt    DateTime?   @default(now()) @map("created_at") @db.Timestamp(6)
  feedback     feedback[]
  memberRole   memberRole? @relation("MemberRoles")
  response     response[]
  saleOrder    saleOrder[]
  carts        cart[] // NEW: reverse relation to cart
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model memberRole {
  memberId Int    @id @map("member_id")
  role     String @db.VarChar(20)
  member   member @relation("MemberRoles", fields: [memberId], references: [memberId], onDelete: NoAction, onUpdate: NoAction)

  @@map("member_role")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model product {
  productId                    Int                           @id @default(autoincrement()) @map("product_id")
  name                         String                        @unique(map: "product_name_unique") @db.VarChar(100)
  description                  String?
  price                        Decimal                       @db.Decimal(10, 2)
  category                     String?                       @db.VarChar(50)
  isAvailable                  Boolean?                      @default(true) @map("is_available")
  createdAt                    DateTime?                     @default(now()) @map("created_at") @db.Timestamp(6)
  feedback                     feedback[]
  saleOrderItem                saleOrderItem[]
  cartItems                    cartItem[] // reverse relation to cartItem
  productQuantityDiscountRules productQuantityDiscountRule[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model response {
  responseId Int       @id @default(autoincrement()) @map("response_id")
  feedbackId Int       @map("feedback_id")
  memberId   Int       @map("member_id")
  comment    String
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  feedback   feedback  @relation(fields: [feedbackId], references: [feedbackId], onDelete: Cascade, onUpdate: NoAction)
  member     member    @relation(fields: [memberId], references: [memberId], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model saleOrder {
  orderId         Int             @id @default(autoincrement()) @map("order_id")
  memberId        Int?            @map("member_id")
  orderDate       DateTime?       @default(now()) @map("order_date") @db.Timestamp(6)
  totalAmount     Decimal         @map("total_amount") @db.Decimal(10, 2)
  status          String          @db.VarChar(20)
  deliveryAddress String?         @map("delivery_address")
  feedback        feedback[]
  member          member?         @relation(fields: [memberId], references: [memberId], onDelete: NoAction, onUpdate: NoAction)
  saleOrderItem   saleOrderItem[]

  @@unique([memberId, orderDate], map: "sale_order_member_date_unique")
  @@map("sale_order")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model saleOrderItem {
  orderItemId Int        @id @default(autoincrement()) @map("order_item_id")
  orderId     Int       @map("order_id")
  productId   Int       @map("product_id")
  quantity    Int
  unitPrice   Decimal    @map("unit_price") @db.Decimal(10, 2)
  subtotal    Decimal    @db.Decimal(10, 2)
  saleOrder   saleOrder? @relation(fields: [orderId], references: [orderId], onDelete: Cascade, onUpdate: NoAction)
  product     product?   @relation(fields: [productId], references: [productId], onDelete: NoAction, onUpdate: NoAction)

  @@map("sale_order_item")
}

model cart {
  cartId    Int       @id @default(autoincrement()) @map("cart_id")
  memberId  Int       @unique @map("member_id")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  // Relations
  member   member     @relation(fields: [memberId], references: [memberId], onDelete: NoAction, onUpdate: NoAction, map: "cart_member_id_fk")
  cartItem cartItem[]

  @@map("cart")
}

model cartItem {
  cartItemId Int     @id @default(autoincrement()) @map("cart_item_id")
  cartId     Int     @map("cart_id")
  productId  Int     @map("product_id")
  quantity   Int
  unitPrice  Decimal @map("unit_price") @db.Decimal(10, 2)

  // Relations
  cart    cart    @relation(fields: [cartId], references: [cartId], onDelete: Cascade, onUpdate: NoAction, map: "cart_item_cart_id_fk")
  product product @relation(fields: [productId], references: [productId], onDelete: NoAction, onUpdate: NoAction, map: "cart_item_product_id_fk")

  @@unique([cartId, productId], map: "cart_item_cart_product_unique")
  @@map("cart_item")
}

model productQuantityDiscountRule {
  ruleId          Int       @id @default(autoincrement()) @map("rule_id")
  name            String    @db.VarChar(100)
  productId       Int       @map("product_id")
  minQuantity     Int       @map("min_quantity")
  discountPercent Decimal   @map("discount_percent") @db.Decimal(5, 2)
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  product product @relation(fields: [productId], references: [productId], onDelete: Cascade, onUpdate: NoAction, map: "product_qty_rule_product_id_fk")

  @@map("product_quantity_discount_rule")
}

model cartValueDiscountRule {
  ruleId          Int       @id @default(autoincrement()) @map("rule_id")
  name            String    @db.VarChar(100)
  minCartValue    Decimal   @map("min_cart_value") @db.Decimal(10, 2)
  discountPercent Decimal   @map("discount_percent") @db.Decimal(5, 2)
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("cart_value_discount_rule")
}

model deliveryFeeRule {
  deliveryFeeRuleId Int       @id @default(autoincrement()) @map("delivery_fee_rule_id")
  minOrderValue     Decimal   @map("min_order_value") @db.Decimal(10, 2)
  deliveryFee       Decimal   @map("delivery_fee") @db.Decimal(10, 2)
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("delivery_fee_rule")
}
